# Logs directory
Logs/
*.log

# Reports directory  
Reports/
Reports/*.html
Reports/*.csv

# Exclude CSV files except sample templates
*.csv
!Sample-*.csv

# PowerShell specific
*.ps1xml

# Temporary files
*.tmp
*.temp
~$*

# IDE and editor files
.vscode/
.vs/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Backup files
*.bak
*.backup

# Test files (optional - remove if you want to commit test data)
# Test-*.csv

# Sensitive data
# Uncomment these if you have files with actual student data
# *Students*.csv
# config.json

# Node modules (if any Node.js tools are added later)
node_modules/

# Python (if any Python tools are added later)
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
